    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
