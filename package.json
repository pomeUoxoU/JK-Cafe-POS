{
  "name": "jk-cafe",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "build": "tsc --noEmit && vite build",
